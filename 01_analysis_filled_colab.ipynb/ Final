        "# --- Data Loading ---\n",
        "# NBER Lalonde / Dehejia-Wahba data.\n",
        "# Variables: treat, age, educ, black, hispan, married, nodegree, re74, re75, re78\n",
        "\n",
        "cols = [\"treat\", \"age\", \"educ\", \"black\", \"hispan\", \"married\", \"nodegree\", \"re74\", \"re75\", \"re78\"]\n",
        "\n",
        "treated_url = \"https://www.nber.org/~rdehejia/data/nswre74_treated.txt\"\n",
        "cps_url = \"https://www.nber.org/~rdehejia/data/cps_controls.txt\"\n",
        "\n",
        "treated = pd.read_csv(treated_url, sep=r\"\\s+\", header=None, names=cols)\n",
        "controls = pd.read_csv(cps_url, sep=r\"\\s+\", header=None, names=cols)\n",
        "\n",
        "df = pd.concat([treated, controls], ignore_index=True)\n",
        "\n",
        "# Add unemployment indicators from pre-treatment earnings\n",
        "df[\"u74\"] = (df[\"re74\"] == 0).astype(int)\n",
        "df[\"u75\"] = (df[\"re75\"] == 0).astype(int)\n",
        "\n",
        "# Save processed data\n",
        "df.to_csv(f\"{project_name}/data/processed/lalonde_cps_analysis.csv\", index=False)\n",
        "\n",
        "print(f\"Shape: {df.shape}\")\n",
        "print(df.head())\n",
        "print(\"\\nTreatment counts:\")\n",
        "print(df[\"treat\"].value_counts())"
      ]

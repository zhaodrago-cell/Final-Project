      "source": [
        "# --- Manual Double Machine Learning with cross-fitting ---\n",
        "\n",
        "Y = df[outcome_col].values\n",
        "T = df[treatment_col].values\n",
        "W = df[control_vars].values\n",
        "\n",
        "def run_dml(Y, T, W, model_y, model_t, n_splits=5, random_state=42):\n",
        "    kf = KFold(n_splits=n_splits, shuffle=True, random_state=random_state)\n",
        "    y_hat = np.zeros_like(Y, dtype=float)\n",
        "    t_hat = np.zeros_like(T, dtype=float)\n",
        "\n",
        "    for train_idx, test_idx in kf.split(W):\n",
        "        model_y.fit(W[train_idx], Y[train_idx])\n",
        "        y_hat[test_idx] = model_y.predict(W[test_idx])\n",
        "\n",
        "        model_t.fit(W[train_idx], T[train_idx])\n",
        "        if hasattr(model_t, \"predict_proba\"):\n",
        "            t_hat[test_idx] = model_t.predict_proba(W[test_idx])[:, 1]\n",
        "        else:\n",
        "            t_hat[test_idx] = model_t.predict(W[test_idx])\n",
        "\n",
        "    y_resid = Y - y_hat\n",
        "    t_resid = T - t_hat\n",
        "\n",
        "    dml_reg = sm.OLS(y_resid, sm.add_constant(t_resid)).fit(cov_type=\"HC1\")\n",
        "    ate = dml_reg.params[1]\n",
        "    se = dml_reg.bse[1]\n",
        "    ci = dml_reg.conf_int()[1]\n",
        "\n",
        "    return {\n",
        "        \"ate\": ate,\n",
        "        \"se\": se,\n",
        "        \"ci_lower\": ci[0],\n",
        "        \"ci_upper\": ci[1],\n",
        "        \"model\": dml_reg,\n",
        "        \"y_hat\": y_hat,\n",
        "        \"t_hat\": t_hat,\n",
        "        \"y_resid\": y_resid,\n",
        "        \"t_resid\": t_resid,\n",
        "    }\n",
        "\n",
        "dml_results = run_dml(\n",
        "    Y, T, W,\n",
        "    model_y=RandomForestRegressor(n_estimators=300, min_samples_leaf=10, random_state=RANDOM_STATE),\n",
        "    model_t=RandomForestClassifier(n_estimators=300, min_samples_leaf=10, random_state=RANDOM_STATE),\n",
        "    n_splits=5,\n",
        "    random_state=RANDOM_STATE\n",
        ")\n",
        "\n",
        "causal_estimate = dml_results[\"ate\"]\n",
        "causal_se = dml_results[\"se\"]\n",
        "causal_ci = [dml_results[\"ci_lower\"], dml_results[\"ci_upper\"]]\n",
        "\n",
        "print(dml_results[\"model\"].summary())\n",
        "print(f\"\\nDML causal ATE: ${causal_estimate:,.2f}\")\n",
        "print(f\"95% CI: [${causal_ci[0]:,.2f}, ${causal_ci[1]:,.2f}]\")"
      ]

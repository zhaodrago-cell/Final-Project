        "print(\"Control:\", n_control)\n",
        "print(\"Naive OLS:\", dollars(naive_ols_effect))\n",
        "print(\"Adjusted OLS:\", dollars(adjusted_ols_effect))\n",
        "print(\"DML ATE:\", dollars(ate))\n",
        "print(\"95% CI:\", dollars(ci_lower), \"to\", dollars(ci_upper))\n",
        "print(\"p-value:\", round(p_value, 4))"
